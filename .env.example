# Athena Diary MCP — embedding / DB config (see docs/CONFIGURATION.md)

# Path to diary SQLite file (created by later slices). Default: ./db/athena-diary.db
# DIARY_DB=/path/to/athena-diary.db

# Embed mode: letta (default on Sanctum — share Letta embed stack) | external
DIARY_EMBED_MODE=letta

# External embed provider (only when DIARY_EMBED_MODE=external)
# DIARY_EMBED_BASE_URL=https://api.example.com/v1
# DIARY_EMBED_MODEL=text-embedding-3-small
# DIARY_EMBED_API_KEY=  # prefer env / ~/.ssh pass file; never commit

# MCP SSE (optional)
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
