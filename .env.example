# Athena Diary MCP — see docs/CONFIGURATION.md
# Product is named after Athena (first agent); use a separate DIARY_DB per agent.

# Path to diary SQLite file (created + migrated on first connect).
# DIARY_DB=./db/athena-diary.db

# Embed mode: letta (default on Sanctum — share Letta embed stack) | external
DIARY_EMBED_MODE=letta

# External embed provider (only when DIARY_EMBED_MODE=external)
# DIARY_EMBED_BASE_URL=https://api.example.com/v1
# DIARY_EMBED_MODEL=text-embedding-3-small
# DIARY_EMBED_API_KEY=  # prefer env / secret store; never commit

# MCP SSE (optional — athena-diary-mcp serve --sse)
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
